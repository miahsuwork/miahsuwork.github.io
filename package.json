{
  "name": "miahsuwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "prettier": "prettier '{,!(.next)/**/}**/*.{js,jsx,ts,tsx,css,json}' --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,json,md}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --report-unused-disable-directives --max-warnings 0"
    ],
    "**/*.{css}": [
      "stylelint --fix --max-warnings 0"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "@headlessui/react": "^2.2.10",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "^10.5.5",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "formik": "^2.2.9",
    "gsap": "^3.12.5",
    "next": "^16.3.4",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.5.0",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "yup": "^1.1.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "typescript-eslint": "^8.70.0"
  }
}
